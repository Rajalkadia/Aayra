  <a class="link text-decoration-none w-100" href="{{ product.url }}">
    <div class="product-media relative flex">
         {% render 'product-badge' product: product %}
          <div class="button-wishlist mobile" data-title="wishlist">
            <button type="button" aria-label="wishlist" class="" button-wishlist data-product-handle="{{ product.handle }}">
              {% render 'icons', icon: 'wishlist' %}
            </button>
          </div>
      <div class="product-media-inner flex relative w-100 small-hide">
          {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 2500, height: 2500 | image_tag: class: "product-image product-main-image" , loading: "lazy", fetchpriority: "auto",  decoding: 'async'  }}
              {%  if product.media[1] != blank %}
                {{ product.media[1] | image_url: width: 2500, height: 2500 | image_tag: class: "product-image product-secondary-image", loading: "lazy", fetchpriority: "auto",  decoding: 'async'  }}
              {%  endif %} 
          {% endif %}
      </div>
      <div class="product-media-inner flex relative w-100 large-up-hide medium-hide">
          {% if product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 800, height: 800 | 
                image_tag: class: "product-image product-main-image" , 
                loading: "lazy", fetchpriority: "auto",  decoding: 'async',
                sizes: "100vw",
                widths: "375, 550, 750, 1100"   }}
               {%  if product.media[1] != blank %}
                {{ product.media[1] | image_url: width: 800, height: 800 | image_tag: class: "product-image product-secondary-image", loading: "lazy", fetchpriority: "auto",   decoding: 'async'  }}
              {%  endif %} 
          {% endif %}
      </div>

    </div>
    <div class="product-content">
        <div class="product-title body-text">
          {{ product.title }}
        </div>

        <div class="product-price">
        {%- render 'price', product: product, block: block, enable_policy: false, font_class: "body-text-v3 color-gray", use_variant: true -%}
        </div>
    </div>
  </a>