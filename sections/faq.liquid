{{ 'faq.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
  #faq-{{ section.id }}{
    --color-foreground: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }},{{ section.settings.text_color.blue }};
    --color-background: {{ section.settings.background_color.red }}, {{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --color-link : var(--color-foreground);
  }
{%- endstyle -%}
<section id="faq-{{ section.id }}" class="faq section-{{ section.id }}-padding">
  {% if section.settings.heading_text != blank %}
    <div class="heading-wrapper page-width flex">
        {%  if section.settings.heading_text != blank %}
          <div class="section-heading body-text-large small-body-text-large uppercase" style="color: {{ section.settings.heading_text_color  }}">
            {{ section.settings.heading_text }}
          </div>
        {%  endif %}
        
    </div>
  {% endif %}

  <div class="faq-wrapper page-width">
    {% for block in section.blocks %}
      <acordion-animated>
        <details>
          <summary class="accordian-title-wrapper">
            <div class="accordian-title body-text">
              <span class="flex">{{ block.settings.question }}</span>
            </div>
            <span class="acoordian-icon-wrapper flex relative">
              <span class="accordian-icon-plus flex">{% render 'icons', icon: 'accordian-plus' %}</span>
              <span class="accordian-icon-minus flex">{% render 'icons', icon: 'accordian-minus' %}</span>
            </span>
          </summary>
          <div class="details-content">
            <div class="details-content-ineer body-text">
              {{ block.settings.answer }}
            </div>
          </div>
        </details>
      </acordion-animated>
    {% endfor %}
  </div>


</section>

{% schema %}
  {
    "name": "t:additionl.faq.label",
    "tag": "section",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "t:additionl.background_color",
        "default": "#F5EFE6"
      },
      {
        "type": "color",
        "id": "heading_text_color",
        "label": "t:additionl.heading_color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:additionl.text_color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "t:additionl.heading"
      },
      {
        "type": "header",
        "content": "t:additionl.padding_desktop"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "t:additionl.padding_top_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "t:additionl.padding_bottom_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "header",
        "content": "t:additionl.padding_mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "t:additionl.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "t:additionl.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      }
    ],
    "blocks": [
      {
        "type": "faq",
        "name": "t:additionl.faq.question_answer",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "t:additionl.faq.question"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "t:additionl.faq.answer",
          },
        ]
      },
    ],
    "presets": [
      {
        "name": "t:additionl.faq.label",
      }
    ]
  }
{% endschema %}