{{ 'hero--banner.css' | asset_url | stylesheet_tag }}
{%- style -%}
 
  {% if section.settings.mobile_height != "auto" %}
     {% assign mobile_aspect_ratio = section.settings.mobile_height | remove: "px" | times: 1 %}
          .video-banner-{{ section.id }} video,
          .video-banner-{{ section.id }} img{
                overflow: hidden;
                 aspect-ratio: 375/{{ mobile_aspect_ratio | default: "750px" }};
          }
    {% endif %}
  @media only screen and (min-width: 769px) {
  
    {% if section.settings.section_height != "auto" %}
      {% assign desktop_aspect_ratio = section.settings.section_height | remove: "px" | times: 1 %}
          .video-banner-{{ section.id }} video,
          .video-banner-{{ section.id }} img {
                aspect-ratio: 1440/{{ desktop_aspect_ratio | default: "750px" }};
                overflow: hidden;
          }
    {% endif %}
  }

  .video-banner-{{ section.id }} {
    color: {{ section.settings.text_color }};
    --overlay-opacity: {{  section.settings.overlay_opacity}}
  }
  .video-banner-{{ section.id }} .button {
   color: {{ section.settings.button_color }};
   background: {{ section.settings.button_background_color }};
   border-color: {{ section.settings.button_background_color }};
  }
  .video-banner-{{ section.id }} .button--secondary{
    background: transparent;
    color: {{ section.settings.button_color }};
    border: 1px solid {{ section.settings.button_color }};
  }

{%- endstyle -%}
{% liquid
    assign banner_link = false
    assign has_only_button  = false
    assign has_media = true
   if  section.settings.title == blank and section.settings.subheading == blank and section.settings.link != blank and section.settings.link_text == blank
      assign banner_link = true
   endif

   if  section.settings.title == blank and section.settings.subheading == blank and section.settings.link != blank and section.settings.link_text != blank
      assign has_only_button = true
   endif

    if section.settings.media_type_mobile == "video"
      if section.settings.video_desktop == blank and section.settings.video_mobile == blank
        assign has_media = false
      endif
    elsif section.settings.media_type_mobile == "image"
      if  section.settings.desktop_image == blank and section.settings.mobile_image == blank
        assign has_media = false
      endif
    endif

%}

<section class="video-banner video-banner-{{ section.id }} scroll-trigger animate--slide-in  {%  if section.index == 1 and section.settings.enable_tranprent_header == true %} transprent-header{%  endif %}">
    <div class="video-banner-wrapper {% if section.settings.ebable_spacing == true %} has-spacing{%  endif %}">
          {% if banner_link == true %}
            <a href="{{ section.settings.link }}" aria-label="Hero banner link"> 
          {%  endif %}
            <div class="video-banner-media flex">
                {% if has_media != false %}
                  {%  render 'banner-image-video', main_section: section %}
                {% else %}
                  {{ 'hero-apparel-2' | placeholder_svg_tag }}
                {% endif %}
            </div>
             {% if banner_link == true %}
              </a>
              {%  endif %}
        {% if has_only_button == true %}
            <div class="video-banner-content page-width content-align-bottom-right">
                 <a href='{{ section.settings.link }}' class="flex video-content-arrow__button body-text-small small-body-text-small">
                  {{ section.settings.link_text }}
                   <span class="flex arrow-link">{% render 'icons', icon: 'button-arrow' %}</span>
                </a>
            </div>
        {%  else %}
          {%  if  section.settings.title != blank or section.settings.subheading != blank or  section.settings.link != blank and section.settings.link_text != blank %}
              <div class="video-banner-content page-width content-align-{{ section.settings.text_align }}">
                  <div class="video-banner-content__inner-wrapper">
                  {%- if section.settings.title != blank -%}
                      <div class="video-content__heading uppercase heading-extra-large small-heading-extra-large heading-text-large-thin">{{ section.settings.title }}</div>
                  {%  endif %}
                  {%- if section.settings.subheading != blank -%}
                      <div class="video-content__subheading heading-text-small-thin">{{ section.settings.subheading }}</div>
                  {%  endif %}
                  {%- if section.settings.description != blank -%}
                      <div class="video-content__description body-text">{{ section.settings.description }}</div>
                  {%  endif %}
                  {%- if section.settings.link != blank and section.settings.link_text != blank -%}
                    <div  class="video-content__button">
                      <a href='{{ section.settings.link }}' class=" button {%if section.settings.button_type == "outline" %} button--secondary {% endif %} body-text-small small-body-text-small">{{ section.settings.link_text }}</a>
                    </div>
                    {%  endif %}
                  </div>
              </div>
          {% endif %}
        {%  endif %}

    </div>

</section>

{% schema %}
{
  "name": "t:additionl.hero_banner.title",
  "class": "index-section--hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_tranprent_header",
      "label": "Enable Transprent Header"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:additionl.text_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:additionl.background_color",
      "default": "#ffffff",
      "visible_if": "{{section.settings.button_type == 'solid'}}",
    },
    {
      "type": "checkbox",
      "id": "ebable_spacing",
      "label": "t:additionl.hero_banner.enable_spacing"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:additionl.button_label",
      "default": "#000000"
    },
     {
      "type": "radio",
      "id": "media_type_desktop",
      "label": "t:additionl.media_type_desktop",
      "default": "video",
      "options": [
        { 
          "value": "image", 
          "label": "t:additionl.image" 
        },
        { 
          "value": "video", 
          "label": "t:additionl.video" 
        }
      ]
    },
    {
      "type": "radio",
      "id": "media_type_mobile",
      "label": "t:additionl.media_type_mobile",
      "default": "video",
      "options": [
        { "value": "image", 
          "label": "t:additionl.image" 
        },
        { 
          "value": "video", 
          "label": "t:additionl.video" 
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:additionl.image_desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:additionl.image_mobile"
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "t:additionl.video_dekstop",
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "t:additionl.Video_mobile",
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:additionl.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:additionl.subheading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:additionl.description"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:additionl.link_text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:additionl.link",
      "info": "t:additionl.hero_banner.link_info"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "t:additionl.button_type",
      "default": "outline",
      "options": [
        {
          "value": "solid",
          "label": "t:additionl.button_solid"
        },
        {
          "value": "outline",
          "label": "t:additionl.button_outline"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:additionl.hero_banner.content_align",
      "default": "center-center",
      "options": [
        {
          "value": "center-left",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__4.label"
        },
        {
          "value": "center-center",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__5.label"
        },
        {
          "value": "center-right",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__9.label"
        }
      ]
    },
 
    {
      "type": "color",
      "alpha": true,
      "id": "overlay_opacity",
      "label": "t:additionl.hero_banner.overlay_color"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:additionl.hero_banner.section_height_desktop",
      "default": "auto",
      "options": [
        {
          "label": "Auto",
          "value": "auto"
        },
        {
          "label": "450px",
          "value": "450px"
        },
        {
          "label": "550px",
          "value": "550px"
        },
        {
          "label": "650px",
          "value": "650px"
        },
        {
          "label": "750px",
          "value": "750px"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:additionl.hero_banner.section_height_mobile",
      "default": "auto",
      "options": [
        {
          "label": "Auto",
          "value": "auto"
        },
         {
          "label": "195px",
          "value": "195px"
        },
        {
          "label": "250px",
          "value": "250px"
        },
        {
          "label": "350px",
          "value": "350px"
        },
        {
          "label": "450px",
          "value": "450px"
        },
        {
          "label": "550px",
          "value": "550px"
        },
        {
          "label": "650px",
          "value": "650px"
        },
        {
          "label": "750px",
          "value": "750px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:additionl.hero_banner.title"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
