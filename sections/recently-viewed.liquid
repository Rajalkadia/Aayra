
{{ 'recently-viewd.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
    #recently-viewed-{{ section.id }}{
      --color-foreground: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }},{{ section.settings.text_color.blue }};
      --color-background: {{ section.settings.background_color.red }}, {{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
      --badge-color: {{ section.settings.badge_text_color }};
      --badge-background-color: {{ section.settings.badge_background_color }};
      --color-link : var(--color-foreground);
  }
{%- endstyle -%}
<section id="recently-viewed-{{ section.id }}" class="recently-viewed isolate section-{{ section.id }}-padding">
<recently-viewd-products
    class="{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.handle }}"
  >
  {% if section.settings.heading_text != blank or section.settings.link_text != blank  %}
    <div class="heading-wrapper uppercase page-width flex">
        {%  if section.settings.heading_text != blank %}
          <div class="section-heading body-text-large  small-body-text-large" style="color: {{ section.settings.heading_text_color  }}">
            {{ section.settings.heading_text }}
          </div>
        {%  endif %}
    
    </div>
  {% endif %}


    
    <collection-product-carousel>
      <div class="swiper js-collection-product-carousel">
        <div class="swiper-wrapper" id="recently-viewed-wrapper">
          {% for recommendation in recommendations.products %}
              <div class=" main-product swiper-slide " id="recently-viewed-card-renderer" style="display:none">
                    {%  render 'custom-product-card', product: recommendation, product_type: false, main_section: section   %}
              </div>
          {% endfor %}
        </div>
      </div>
    </collection-product-carousel>
  </recently-viewd-products>

</section>

{% schema %}
  {
    "name": "t:additionl.recently_view",
    "tag": "section",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "t:additionl.background_color",
        "default": "#F5EFE6"
      },
      {
        "type": "color",
        "id": "heading_text_color",
        "label": "t:additionl.heading_color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:additionl.text_color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "button_color",
        "label": "t:additionl.button_label",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "badge_background_color",
        "label": "t:additionl.badge_background_color",
        "alpha": true,
        "default": "#00000080"
      },
      {
        "type": "color",
        "id": "badge_text_color",
        "label": "t:additionl.badge_text_color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "t:additionl.heading"
      },
      //{
        //"type": "text",
        //"id": "link_text",
        //"label": "t:additionl.link_text",
        //"default": "view All"
      //},

      {
        "type": "header",
        "content": "t:additionl.padding_desktop"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "t:additionl.padding_top_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "t:additionl.padding_bottom_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "header",
        "content": "t:additionl.padding_mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "t:additionl.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "t:additionl.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      }
    ],
    "presets": [
      {
        "name": "t:additionl.recently_view",
      }
    ]
  }
{% endschema %}