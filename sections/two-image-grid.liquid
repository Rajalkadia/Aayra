{{ 'two-image-grid.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #two-image-grid-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }
 .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}
<section id="two-image-grid-{{ section.id }}" class="two-image-grid section-{{ section.id }}-padding" >
  {%  if section.settings.heading != blank %}
          <div class="section-heading heading-text-large-thin center" style="color: {{ section.settings.heading_text_color  }}">
            {{ section.settings.heading }}
          </div>
        {%  endif %}

  <div class="two-image-grid-wrapper page-width relative">
    {% for block in section.blocks %}
        <div class="two-image-item">
          <div class="two-image-grid-item flex">
            {% if block.settings.image != blank%}
              {{ block.settings.image  | image_url: width: 2500, height:3500 | image_tag  }}
            {%  else %}
              {{ 'collection-apparel-'|append: forloop.index | placeholder_svg_tag: 'w-100 h-100' }}
            {% endif %}
          </div>
        {% if block.settings.heading != blank or block.settings.subheading != blank %}
            <div class="two-image-grid-content-wrapper">
              <div class="two-image-item-inner-wrapper">
                {% if block.settings.heading != blank %}
                  <div class="two-image-grid__heading heading-text-large-thin" style="color: {{ section.settings.text_color }}">{{ block.settings.heading }}</div>
                {% endif %}
                {% if block.settings.subheading != blank %}
                  <div class="two-image-grid__subheading body-text" style="color: {{ section.settings.text_color }}">{{ block.settings.subheading }}</div>
                {% endif %}
              </div>
            </div>
          {%  endif %}
        </div>
      {% endfor %}
    </div>


</section>

{% schema %}
  {
    "name": "t:additionl.two_image_grid",
    "tag": "section",
    "max_blocks": 2,
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "t:additionl.background_color",
        "default": "#F5EFE6"
      },
      {
        "type": "color",
        "id": "heading_text_color",
        "label": "t:additionl.heading_color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:additionl.text_color",
        "default": "#000000"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "t:additionl.heading"
      },
      {
        "type": "header",
        "content": "t:additionl.padding_desktop"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "t:additionl.padding_top_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 70
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "t:additionl.padding_bottom_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "header",
        "content": "t:additionl.padding_mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "t:additionl.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "t:additionl.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      }      
    ],
    "blocks": [
      {
        "type": "Image",
        "name": "t:additionl.image",
        "limit": 2,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "t:additionl.image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "t:additionl.heading"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "t:additionl.subheading"
          },
        ]
      },
    ],
    "presets": [
      {
        "name": "t:additionl.two_image_grid",
      }
    ]
  }
{% endschema %}