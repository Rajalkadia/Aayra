{{ 'collection-grid.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
  #collection-grid-{{ section.id }}{
    --color-foreground: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }},{{ section.settings.text_color.blue }};
    --color-background: {{ section.settings.background_color.red }}, {{ section.settings.background_color.green }},{{ section.settings.background_color.blue }};
    --color-link : var(--color-foreground);
  }
{%- endstyle -%}
<section id="collection-grid-{{ section.id }}" class="collection-grid section-{{ section.id }}-padding">
  {% if section.settings.heading_text != blank or section.settings.link != blank and section.settings.link_text != blank  %}
    <div class="heading-wrapper page-width flex">
        {%  if section.settings.heading_text != blank %}
          <div class="section-heading body-text-large" style="color: {{ section.settings.heading_text_color  }}">
            {{ section.settings.heading_text }}
          </div>
        {%  endif %}
        {% if section.settings.link != blank and section.settings.link_text != blank %}
          <a class="link body-text-v2 uppercase" href="{{ section.settings.link  }}" style="color: {{  section.settings.button_color }}"> {{ section.settings.link_text }}</a>
        {% endif %}
    </div>
  {% endif %}

  <div class="collection-grid-wrapper">
    <collection-grid-carousel>
      <div class="swiper js-collection-grid-carousel">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
              <div class="collection-grid-item swiper-slide flex">
                {% if block.settings.link != blank  %}
                  <a class="link text-decoration-none w-100" href="{{ block.settings.link.url }}" >
                {%  endif %}
                  <div class="collection-media-wrapper">
                    <div class="collection-media relative flex">
                      {%  if block.settings.collection_image != blank  %}
                        {{ block.settings.collection_image
                          | image_url: width: 3500  
                          | image_tag:
                            sizes: "100vw",
                            widths: "375, 550, 750, 1100, 1600, 2000, 3500",
                            loading: 'lazy',
                            decoding: 'async'
                        }}
                      {%  else %}
                        {{ 'collection-apparel-'| append: forloop.index  | placeholder_svg_tag }}
                      {%  endif %}
                        {% if block.settings.collection_text != blank %}
                          <div class="collection-text heading-text-large-thin small-heading-text-large-thin flex"> 
                            {{ block.settings.collection_text }} 
                          </div>
                        {% endif %}
                    </div>
                  </div>
              {% if block.settings.link != blank  %}
                </a>
              {%  endif %}
              </div>
          {% endfor %}
      </div>
      <div class="swiper-pagination carousel-grid-pagination large-up-hide medium-hide"></div>
    </div>
    </collection-grid-carousel>
  </div>


</section>

{% schema %}
  {
    "name": "t:additionl.collection_section.collection_grid",
    "tag": "section",
    "max_blocks": 3,
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "t:additionl.background_color",
        "default": "#F5EFE6"
      },
      {
        "type": "color",
        "id": "heading_text_color",
        "label": "t:additionl.heading_color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:additionl.text_color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "button_color",
        "label": "t:additionl.button_label",
        "default": "#000000"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "t:additionl.heading"
      },
      {
        "type": "text",
        "id": "link_text",
        "label": "t:additionl.link_text"
      },
      {
        "type": "url",
        "id": "link",
        "label": "t:additionl.link"
      },
      {
        "type": "header",
        "content": "t:additionl.padding_desktop"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "t:additionl.padding_top_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "t:additionl.padding_bottom_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "header",
        "content": "t:additionl.padding_mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "t:additionl.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "t:additionl.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 25
      }
    ],
    "blocks": [
      {
        "type": "collection",
        "name": "t:additionl.collection_section.collection_item",
        "limit": 3,
        "settings": [
          {
            "type": "image_picker",
            "id": "collection_image",
            "label": "t:additionl.collection_section.collection_iamge"
          },
          {
            "type": "richtext",
            "id": "collection_text",
            "label": "t:additionl.collection_section.collection_text",
          },
          {
            "type": "url",
            "id": "link",
            "label": "t:additionl.collection"
          }
        ]
      },
    ],
    "presets": [
      {
        "name": "t:additionl.collection_section.collection_grid",
      }
    ]
  }
{% endschema %}